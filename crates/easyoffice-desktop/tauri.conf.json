{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyOffice",
  "mainBinaryName": "EasyOffice",
  "identifier": "com.aquilaxk.easyoffice",
  "build": {
    "frontendDist": "../easyoffice-app/ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "img-src": "'self' data: blob:",
        "frame-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "EasyOffice",
    "copyright": "Copyright (c) EasyOffice contributors. MIT License.",
    "category": "Productivity",
    "shortDescription": "EasyOffice offline office workspace",
    "longDescription": "EasyOffice is an offline desktop office workspace for documents, HWP, spreadsheets, slides, and PDF.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["hwp"], "name": "EasyOffice.Hwp", "description": "한글 문서 (HWP)", "role": "Editor", "rank": "Alternate", "mimeType": "application/x-hwp" },
      { "ext": ["hwpx"], "name": "EasyOffice.Hwpx", "description": "한글 문서 (HWPX)", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.hancom.hwpx" },
      { "ext": ["docx"], "name": "EasyOffice.Docx", "description": "문서 (DOCX)", "role": "Editor", "rank": "Alternate" },
      { "ext": ["odt"], "name": "EasyOffice.Odt", "description": "문서 (ODT)", "role": "Editor", "rank": "Alternate" },
      { "ext": ["xlsx"], "name": "EasyOffice.Xlsx", "description": "스프레드시트 (XLSX)", "role": "Editor", "rank": "Alternate" },
      { "ext": ["ods"], "name": "EasyOffice.Ods", "description": "스프레드시트 (ODS)", "role": "Editor", "rank": "Alternate" },
      { "ext": ["pptx"], "name": "EasyOffice.Pptx", "description": "프레젠테이션 (PPTX)", "role": "Editor", "rank": "Alternate" },
      { "ext": ["odp"], "name": "EasyOffice.Odp", "description": "프레젠테이션 (ODP)", "role": "Editor", "rank": "Alternate" },
      { "ext": ["pdf"], "name": "EasyOffice.Pdf", "description": "PDF 문서", "role": "Viewer", "rank": "Alternate" }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
