{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyOffice",
  "mainBinaryName": "EasyOffice",
  "identifier": "com.aquilaxk.easyoffice",
  "build": {
    "frontendDist": "../easyoffice-app/ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "img-src": "'self' data: blob:",
        "frame-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "capabilities": ["main-window"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5MDQ3NDBFQTNBOTYwMDAKUldRQVlLbWpEblFFQ2FFRktPRFhpNWZ0UFVtMmJqNGFodTVib1c2M0ZKbzJualVTemV6WFZGZG4K",
      "endpoints": ["https://github.com/AquilaXk/easyoffice/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "publisher": "EasyOffice",
    "copyright": "Copyright (c) EasyOffice contributors. MIT License.",
    "category": "Productivity",
    "shortDescription": "EasyOffice offline office workspace",
    "longDescription": "EasyOffice is an offline desktop office workspace for documents, HWP, spreadsheets, slides, and PDF.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../third_party/rhwp/ttfs/opensource/NotoSansKR-Regular.ttf": "pdf-fonts/NotoSansKR-Regular.ttf",
      "../../third_party/rhwp/ttfs/opensource/NotoSansKR-OFL.txt": "pdf-fonts/NotoSansKR-OFL.txt"
    },
    "fileAssociations": [
      { "ext": ["hwp"], "name": "EasyOffice.Hwp", "description": "한글 문서 (HWP)", "role": "Editor", "rank": "Alternate", "mimeType": "application/x-hwp",
        "contentTypes": ["com.aquilaxk.easyoffice.hwp", "com.hancom.hwp"],
        "exportedType": { "identifier": "com.aquilaxk.easyoffice.hwp", "conformsTo": ["public.data"] } },
      { "ext": ["hwpx"], "name": "EasyOffice.Hwpx", "description": "한글 문서 (HWPX)", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.hancom.hwpx",
        "contentTypes": ["com.aquilaxk.easyoffice.hwpx", "com.hancom.hwpx"],
        "exportedType": { "identifier": "com.aquilaxk.easyoffice.hwpx", "conformsTo": ["public.data", "public.zip-archive"] } },
      { "ext": ["docx"], "name": "EasyOffice.Docx", "description": "문서 (DOCX)", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document" },
      { "ext": ["odt"], "name": "EasyOffice.Odt", "description": "문서 (ODT)", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.oasis.opendocument.text" },
      { "ext": ["xlsx"], "name": "EasyOffice.Xlsx", "description": "스프레드시트 (XLSX)", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
      { "ext": ["ods"], "name": "EasyOffice.Ods", "description": "스프레드시트 (ODS)", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.oasis.opendocument.spreadsheet" },
      { "ext": ["pptx"], "name": "EasyOffice.Pptx", "description": "프레젠테이션 (PPTX)", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation" },
      { "ext": ["odp"], "name": "EasyOffice.Odp", "description": "프레젠테이션 (ODP)", "role": "Editor", "rank": "Alternate", "mimeType": "application/vnd.oasis.opendocument.presentation" },
      { "ext": ["pdf"], "name": "EasyOffice.Pdf", "description": "PDF 문서", "role": "Viewer", "rank": "Alternate", "mimeType": "application/pdf" }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "PlugIns/EasyOfficeQuickLookPreview.appex": "../../target/quicklook/PlugIns/EasyOfficeQuickLookPreview.appex",
        "PlugIns/EasyOfficeQuickLookThumbnail.appex": "../../target/quicklook/PlugIns/EasyOfficeQuickLookThumbnail.appex"
      },
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libxdo3", "libssl3"],
        "recommends": ["xdg-utils"],
        "desktopTemplate": "./linux/easyoffice.desktop"
      },
      "rpm": {
        "depends": ["libwebkit2gtk-4.1.so.0()(64bit)", "libgtk-3.so.0()(64bit)", "libxdo.so.3()(64bit)", "libssl.so.3()(64bit)"],
        "desktopTemplate": "./linux/easyoffice.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
