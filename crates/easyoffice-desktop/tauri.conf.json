{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyOffice",
  "mainBinaryName": "EasyOffice",
  "identifier": "com.aquilaxk.easyoffice",
  "build": {
    "frontendDist": "../easyoffice-app/ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "EasyOffice",
    "copyright": "Copyright (c) EasyOffice contributors. MIT License.",
    "category": "Productivity",
    "shortDescription": "EasyOffice offline office workspace",
    "longDescription": "EasyOffice is an offline desktop office workspace for documents, HWP, spreadsheets, slides, and PDF.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
